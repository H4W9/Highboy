# ============================================================================
# TentacleOS — Pancake target (ESP32-C5, ST7796S + FT6336 touch)
# ============================================================================

# Flash — 8MB, 80MHz, DIO (Waveshare/Pancake ESP32-C5)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Custom partition table (8MB layout, see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU 240MHz (C5 maximum)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM — quad mode, 40MHz (Pancake / ESP32-C5-DevKitC-1)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Larger stack for kernel_init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console over USB-Serial-JTAG (ESP32-C5 has no USB-OTG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# On a crash, print the backtrace and HALT (don't reboot) so the panic stays
# on the USB-Serial-JTAG console instead of being lost in a reboot loop.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_PANIC_HANDLER_IRAM=y

# Required for sys_monitor (uxTaskGetSystemState / vTaskList)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# LVGL fonts used by UI components
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# Default log level INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
